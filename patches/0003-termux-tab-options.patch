+
+#[test]
+fn tab_tap_opens_options_without_copying_and_rename_targets_the_tapped_tab() {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(snapshot()));
+    state.set_pane_surface(surface());
+    state.compose(106, 20).expect("tab bar");
+    let tab = state.hits.tabs[0].0;
+    let mouse = |kind| {
+        RawInputEvent::Mouse(crossterm::event::MouseEvent {
+            kind,
+            column: tab.x + 1,
+            row: tab.y,
+            modifiers: KeyModifiers::empty(),
+        })
+    };
+    let down = state.handle_raw_events(vec![mouse(MouseEventKind::Down(MouseButton::Left))]);
+    assert!(down.actions.is_empty());
+    assert!(state.overlay.is_none());
+
+    let up = state.handle_raw_events(vec![mouse(MouseEventKind::Up(MouseButton::Left))]);
+    assert!(up.repaint);
+    assert!(up.requests.is_empty());
+    assert!(matches!(
+        &up.actions[..],
+        [ClientShellAction::Endpoint { request, .. }]
+            if matches!(&request.method, crate::api::schema::Method::TabFocus(target) if target.tab_id == "tab_1")
+    ));
+    assert!(state.selection.is_none());
+    let Some(ClientShellOverlay::ContextMenu(menu)) = &state.overlay else {
+        panic!("tap should open tab options");
+    };
+    assert!(matches!(
+        &menu.target,
+        ClientContextMenuTarget::Tab { tab_id, workspace_id }
+            if tab_id == "tab_1" && workspace_id == "ws_1"
+    ));
+    assert_eq!(
+        menu.items()
+            .iter()
+            .map(|item| item.label)
+            .collect::<Vec<_>>(),
+        vec!["New tab", "Rename", "Close"]
+    );
+
+    state.compose(106, 20).expect("tab options");
+    let rename = state
+        .hits
+        .context_menu_rows
+        .iter()
+        .find_map(|(rect, index)| (*index == 1).then_some(*rect))
+        .expect("rename option");
+    state.handle_raw_events(vec![RawInputEvent::Mouse(crossterm::event::MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: rename.x,
+        row: rename.y,
+        modifiers: KeyModifiers::empty(),
+    })]);
+    assert!(matches!(
+        &state.overlay,
+        Some(ClientShellOverlay::Rename(ClientRenameOverlay {
+            target: ClientRenameTarget::Tab { tab_id, .. },
+            ..
+        })) if tab_id == "tab_1"
+    ));
 }
 
